# ==============================================================================
# EduForge360 Environment Configuration Example
# Copy this file to .env and adjust credentials. Never commit .env to Git!
# ==============================================================================

# Environment Mode (development | staging | production)
WP_ENV=development
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
SCRIPT_DEBUG=true

# Database Credentials
DB_NAME=eduforge360_db
DB_USER=eduforge_user
DB_PASSWORD=eduforge_secure_pass_2026
DB_HOST=mysql
DB_PORT=3306
DB_TABLE_PREFIX=wp_

# Site Information
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Caching & Redis (Optional)
WP_CACHE=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Salts (Generate via https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY='replace_with_unique_secure_key_phrase'
SECURE_AUTH_KEY='replace_with_unique_secure_key_phrase'
LOGGED_IN_KEY='replace_with_unique_secure_key_phrase'
NONCE_KEY='replace_with_unique_secure_key_phrase'
AUTH_SALT='replace_with_unique_secure_key_phrase'
SECURE_AUTH_SALT='replace_with_unique_secure_key_phrase'
LOGGED_IN_SALT='replace_with_unique_secure_key_phrase'
NONCE_SALT='replace_with_unique_secure_key_phrase'

# Payment Gateways (India / Razorpay / Cashfree / Stripe - Sandbox / Live)
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=sample_secret_key_never_commit
PAYMENT_CURRENCY=INR

# SMTP Mail Settings (Leave empty for local mailcatcher)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@eduforge360.edu
SMTP_FROM_NAME="EduForge360 Platform"
